# SilexGIS TLS front (used by docker-compose.tls.yml).
# Caddy terminates TLS with an automatically provisioned Let's Encrypt certificate and
# reverse-proxies to the web (nginx) service. X-Forwarded-Proto=https is added for us, so the
# API issues https OIDC redirects (PublicUrl must be the https address).
#
# Both variables are required (compose enforces it): `email` rejects an empty argument, so an
# unset SILEXGIS_TLS_EMAIL would make Caddy fail to parse this file.
#
# Deliberately no request-body limit here. Caddy imposes none unless one is written, and the
# nginx service behind it already caps bodies above every configured upload limit. A cap set
# here as well would only add a second place to forget when an installation raises the upload
# limit — and a body refused at this hop fails with an error the application never sees.

{
	email {$SILEXGIS_TLS_EMAIL}
}

{$SILEXGIS_DOMAIN} {
	encode gzip zstd
	reverse_proxy web:80
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
