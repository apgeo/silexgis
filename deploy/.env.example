# SilexGIS deployment configuration — copy to .env and edit.

# REQUIRED: database password (internal network only, but pick a strong one).
SILEXGIS_DB_PASSWORD=change-me

# Public URL users reach the app on. Must match exactly (OIDC redirect URIs derive from it).
# Behind a TLS proxy, use the https:// address.
SILEXGIS_PUBLIC_URL=http://localhost:8080

# Host port the web service listens on (plain HTTP; ignored when using the TLS overlay).
SILEXGIS_HTTP_PORT=8080

# --- TLS (only when using docker-compose.tls.yml, which adds Caddy + Let's Encrypt) --------
# Both are REQUIRED with that overlay (unused otherwise).
# Public hostname whose DNS points at this host; ports 80 and 443 must be reachable.
# SILEXGIS_DOMAIN=caves.example.org
# Contact address Let's Encrypt uses for expiry/revocation notices.
# SILEXGIS_TLS_EMAIL=admin@example.org
# Remember to set SILEXGIS_PUBLIC_URL=https://caves.example.org above.

# --- Database browser (only when using docker-compose.pgadmin.yml, which adds pgAdmin) ----
# The password is REQUIRED with that overlay (unused otherwise): pgAdmin stores database
# credentials, so it gets its own login rather than a shipped default.
# SILEXGIS_PGADMIN_PASSWORD=change-me
# SILEXGIS_PGADMIN_EMAIL=admin@example.com
# Loopback-only host port for the pgAdmin web UI.
# SILEXGIS_PGADMIN_PORT=5050
#
# Development only: docker-compose.dbport.yml publishes the database itself on this
# loopback port for desktop clients. Never add that overlay to a deployed installation.
# SILEXGIS_DB_HOST_PORT=5433

# --- Notifications ------------------------------------------------------------------------
# How often queued notifications are sent. 0 switches sending off but keeps queuing them.
# SILEXGIS_NOTIFICATIONS_POLL_SECONDS=15
# Hour (UTC) at which daily summaries go out, for users who chose one message a day.
# SILEXGIS_NOTIFICATIONS_DIGEST_HOUR_UTC=7

# --- Terrain (optional; only when using docker-compose.terrain.yml) -------------------------
# Real relief under the caves in the 3D view. With none of this set the globe is the smooth
# reference ellipsoid, which needs nothing installed, downloaded or pre-baked.
#
# Bake a pyramid first — `node deploy/terrain.mjs fetch`, then `... bake` — and it prints the
# exact lines below for what it produced. See "Terrain" in docs/INSTALL.md.
#
# Host directory holding layer.json. REQUIRED with that overlay (unused otherwise).
# SILEXGIS_TERRAIN_DIR=/srv/silexgis/terrain
# Where a browser asks for the tiles. Must match the mount above; the trailing slash matters.
# SILEXGIS__Terrain__Url=/terrain/
# What the tile heights are measured from: Orthometric (above sea level, which is what an
# unconverted elevation model holds) or Ellipsoidal (converted when baked). Wrong here puts
# every cave about forty metres off its hillside with nothing on screen to say so.
# SILEXGIS__Terrain__HeightDatum=Orthometric
# The local geoid undulation in metres, used ONLY with Ellipsoidal. Measured EGM2008 values over
# Romanian karst run +39 to +45 m.
# SILEXGIS__Terrain__GeoidHeightM=0
# Credit the elevation data's licence requires; shown on the scene. It belongs to whatever you
# actually baked, so take the line the bake printed rather than the example below — which is the
# Copernicus GLO-30 credit and is true only of a pyramid baked from Copernicus data.
# SILEXGIS__Terrain__Attribution=Copernicus DEM GLO-30 — © DLR e.V. 2010-2014 and © Airbus Defence and Space GmbH 2014-2018 provided under COPERNICUS by the European Union and ESA
# Where a build started from inside the application does its work. Each build gets a folder of its
# own here holding the rasters it was given and what it makes of them; they are kept until somebody
# deletes the build, so this wants a disk chosen for size. Nothing is written here until somebody
# starts a build.
#
# The compose stack already sets this to /data/terrain/builds, which is a named volume, so leave it
# alone unless that disk is too small. A path named here is a path INSIDE the api container and must
# be mounted into it — pointing this at a host directory without also mounting it puts tens of
# gigabytes in the container's own writable layer, where they disappear on the next recreate. To use
# a bigger disk, bind-mount it over /data/terrain in docker-compose.yml rather than changing this —
# the compose file's own mapping wins over anything set here in any case.
# SILEXGIS__Terrain__BuildRoot=/data/terrain/builds
# Where a finished, checked pyramid is MOVED so the web server can serve it, at
# /terrain/builds/<build id>/. A directory of its own holding nothing but finished tiles, and the
# only directory a serving rule may ever be pointed at: one level up are the rasters the builds
# were made from, and there is no sign-in in front of any of it. Much smaller than the build root.
# The compose stack sets this and the shipped web configuration is built around it, so changing it
# means changing that serving rule to match and rebuilding the web image.
# SILEXGIS__Terrain__PublishRoot=/data/terrain/published
# How long one cell of elevation may take to arrive before the attempt is abandoned. A cell is some
# tens of megabytes, so twenty minutes is generous on any usable link and still short enough that a
# connection which has stopped delivering does not hold a build open until somebody notices.
# SILEXGIS__Terrain__CellTimeoutSeconds=1200

# --- Terrain baking (optional; only when using docker-compose.terrain-worker.yml) -------------
# Lets the application bake a pyramid itself, from an area chosen inside it, instead of somebody
# running the bake by hand. The tile-making step runs as a service of its own, because it is a
# 1.4 GB image and several gigabytes of memory that an installation which never bakes terrain
# should not have to carry:
#
#   docker compose -f docker-compose.yml -f docker-compose.terrain-worker.yml up -d
#
# REQUIRED with that overlay, which refuses to start without it — it is what tells the application
# there is a worker to hand its bakes to. Set with no worker running, a build waits for a bake
# that nothing will ever do.
# SILEXGIS__Terrain__BakeEnabled=true
# Memory one bake may use. The tile-maker takes its heap as a percentage of this and has no other
# setting for it, so this is the only knob there is — and short of memory it does not fail, it
# stops refining and quietly writes coarser tiles than were asked for. A couple of hundred square
# kilometres with one fine island in it was measured peaking around 2.5 GB.
# SILEXGIS_TERRAIN_WORKER_MEMORY=8g
# How often the worker looks for something to bake, in seconds.
# SILEXGIS_TERRAIN_WORKER_POLL_SECONDS=2
# Where the application leaves a request and the worker leaves its answer. Both sides must name
# the same directory and both compose files already do, so leave this alone: it is a path inside
# the api container, on the same volume the worker mounts.
# SILEXGIS__Terrain__SpoolRoot=/data/terrain/spool
# How long a build waits for the worker to take its bake before deciding nothing is going to. This
# is what tells a worker nobody started apart from one that is still starting, so it is generous:
# a request waiting costs nothing, and a wrong answer here sends somebody looking for a crash that
# never happened. Values outside 5 seconds to an hour are brought back inside that range, so 0 is
# not "wait indefinitely": it becomes 5 seconds, and reports a starting worker as one that is absent.
# SILEXGIS__Terrain__BakePickupSeconds=300
# How long one bake may run before it is abandoned. The queue a build runs on has no time limit of
# its own, so this is the only one there is; it is meant to catch a bake that has stopped making
# progress rather than to cap a large one, and half a day is far beyond anything measured. Values
# outside a minute to seven days are brought back inside that range, so 0 is not "no limit": it
# becomes a minute, and every real bake is then abandoned before it can finish.
# SILEXGIS__Terrain__BakeTimeoutSeconds=43200

# --- Data integrity -------------------------------------------------------------------------
# How often a background pass re-checks the map data for internal inconsistencies. Findings
# are logged and shown in the admin jobs list; nothing is changed automatically. 00:00:00
# turns the schedule off, leaving the pass available to start by hand. A day is written
# d.hh:mm:ss, so one day is 1.00:00:00 — "24:00:00" would be read as twenty-four days.
# SILEXGIS__FeatureIntegrity__Interval=1.00:00:00

# --- Uploads --------------------------------------------------------------------------------
# Largest file an upload may carry, in bytes. Default 536870912 (512 MB), which is sized for
# long scans and field recordings rather than photographs alone.
#
# Three limits govern one upload and they have to move together. The application's limit is
# this value; the request-body and multipart limits are derived from it automatically. The
# third is the reverse proxy in front, which refuses an oversized body before the application
# ever sees it — the bundled web service allows 1 GB, so any value up to that works as is.
# Above 1 GB, edit client/nginx.conf and rebuild the web image: that value is compiled into
# the image and cannot be set from here.
# SILEXGIS_MAX_UPLOAD_BYTES=536870912

# How much stored content one account may own, in bytes. 0 (the default) means no personal
# limit, which is what a club installation wants: the people using it are known to each other,
# and a quota that has to be raised by hand the first time somebody scans a survey is a support
# request rather than a protection. An individual account can be given its own figure, which
# overrides this one.
# SILEXGIS_USER_QUOTA_BYTES=0

# How much the whole installation may hold, in bytes. 0 (the default) means no limit. This is
# the one that actually protects the disk — quotas are not allocations, nothing is reserved,
# and the sum of everybody's may legitimately exceed the volume. Whoever mounted the volume is
# the one who knows what belongs here.
# SILEXGIS_MAX_TOTAL_STORE_BYTES=0

# How many days a deleted document or photograph can still be got back before its bytes go.
# 0 is a real setting, for an installation where deleting means deleting.
# SILEXGIS_RETENTION_DAYS=30

# Directories on the server's own disk an administrator may import from. Empty (the default)
# switches importing from the filesystem off entirely, and that is a security boundary rather
# than a capacity one: an import reads whatever the service account can open, so the reachable
# directories are named by whoever deploys the installation — not chosen by whoever is signed
# in. Under Docker the path is resolved inside the api container, so a root named here must
# also be mounted into it.
#
# One list, two features: it governs importing documents and reading elevation rasters for a terrain
# build alike. Deliberately one, because it answers one question — which directories on this machine
# the application may read — and two lists would be two places for an operator to get it wrong.
# SILEXGIS__Files__ImportRoots__0=/data/import

# First-run administrator (created only if the account does not exist yet).
SILEXGIS_ADMIN_EMAIL=admin@example.com
SILEXGIS_ADMIN_PASSWORD=change-me-please

# Allow self-registration (default: false — admins create accounts).
SILEXGIS_OPEN_REGISTRATION=false

# Permission groups (comma-separated slugs, e.g. editors) that every new account joins —
# at self-registration and when an external provider auto-creates an account. Empty means
# new accounts start with the built-ins only: browse what is visible to them, keep their
# own saved views, take part in trips. This line passes straight through to the API.
# SILEXGIS__Auth__DefaultPermissionGroups=

# How many sign-in, password-reset and token requests one IP address may make per minute
# before the rest are refused. Sixty is generous for a person and mean for a script. Raise
# it where a whole club reaches the server through one outbound address, which is what a
# shared connection or a mobile carrier looks like from here — every user then counts
# against the same allowance. This line passes straight through to the API.
# SILEXGIS__Auth__RateLimitPerMinute=60

# How long the SpeleoLoc mobile app may stay offline before a caver has to sign in on it
# again. The clock restarts at every successful sync rather than at sign-in, so a phone
# that syncs monthly never re-authenticates and one left in a drawer for seven weeks does.
# A lapsed credential costs a sign-in and never data: the phone's own database is what
# holds its work. This is deliberately longer than the browser's window, because the phone
# is the client that keeps a credential for weeks and the one that gets lost — which is
# also why changing or resetting an account's password signs every one of its devices out.
# Values outside 1 to 365 days are brought back inside that range, so a slipped digit
# cannot mint a credential lasting years. This line passes straight through to the API.
# SILEXGIS__Auth__SpeleoLocRefreshTokenDays=45

# --- Mobile sync limits (optional) ---------------------------------------------
# What a phone is told it may expect before it starts talking. It asks once, then sizes
# its own pages and batches to the answer, which is why these are announced rather than
# discovered by a request that fails in a cave with no signal. Raising them costs memory
# and response time per request; lowering them costs round trips. The shipped figures suit
# a mobile connection rather than any storage limit. Values outside 1 to 5000 are brought
# back inside that range. These lines pass straight through to the API container.
# SILEXGIS__Sync__PageSizeMax=500
# SILEXGIS__Sync__UploadRowsMax=500

# --- External login providers (optional; none configured by default) ---------------
# Federate Google / GitHub / any OIDC issuer into local accounts. Add one block per
# provider, numbered from 0. Register the redirect URI shown below with the provider.
# These SILEXGIS__* lines pass straight through to the API container.
#
# Register this exact redirect URI with the provider (name = the __0__Name value):
#   <SILEXGIS_PUBLIC_URL>/api/v1/signin-<name>
#
# Google (OIDC; issuer is built in):
# SILEXGIS__Auth__ExternalProviders__0__Name=google
# SILEXGIS__Auth__ExternalProviders__0__Type=google
# SILEXGIS__Auth__ExternalProviders__0__DisplayName=Google
# SILEXGIS__Auth__ExternalProviders__0__ClientId=your-google-client-id
# SILEXGIS__Auth__ExternalProviders__0__ClientSecret=your-google-client-secret
# SILEXGIS__Auth__ExternalProviders__0__AllowCreate=false
#
# GitHub (OAuth 2.0):
# SILEXGIS__Auth__ExternalProviders__1__Name=github
# SILEXGIS__Auth__ExternalProviders__1__Type=github
# SILEXGIS__Auth__ExternalProviders__1__DisplayName=GitHub
# SILEXGIS__Auth__ExternalProviders__1__ClientId=your-github-client-id
# SILEXGIS__Auth__ExternalProviders__1__ClientSecret=your-github-client-secret
#
# Generic OIDC (e.g. Keycloak, Authentik):
# SILEXGIS__Auth__ExternalProviders__2__Name=sso
# SILEXGIS__Auth__ExternalProviders__2__Type=oidc
# SILEXGIS__Auth__ExternalProviders__2__DisplayName=Company SSO
# SILEXGIS__Auth__ExternalProviders__2__Authority=https://sso.example.com/realms/main
# SILEXGIS__Auth__ExternalProviders__2__ClientId=silexgis
# SILEXGIS__Auth__ExternalProviders__2__ClientSecret=your-client-secret
#
# AllowCreate=true provisions a local account on first sign-in (needs a provider-verified
# email); default false requires the account to exist or be linked from account settings.
# Hide the password form entirely once providers are set:
# SILEXGIS__Auth__ExternalOnly=true

# ---------------------------------------------------------------------------
# Email delivery (optional)
# ---------------------------------------------------------------------------
# With no mail server configured everything still works: confirmation links and
# sign-in codes are written to the API container log instead of being sent.
# These can also be set from the admin UI (Messaging), which overrides what is here.
#
# SILEXGIS__Mail__Enabled=true
# SILEXGIS__Mail__Host=smtp.example.org
# SILEXGIS__Mail__Port=587
# Security: Auto (default) | StartTls | SslOnConnect (port 465) | None
# SILEXGIS__Mail__Security=Auto
# SILEXGIS__Mail__Username=silexgis@example.org
# SILEXGIS__Mail__Password=your-smtp-password
# SILEXGIS__Mail__FromAddress=silexgis@example.org
# SILEXGIS__Mail__FromName=Cave Register
# SILEXGIS__Mail__ReplyTo=
# Only for an internal relay with a self-signed certificate — it removes the
# protection on the password above:
# SILEXGIS__Mail__AcceptInvalidCertificate=false

# ---------------------------------------------------------------------------
# SMS delivery (optional)
# ---------------------------------------------------------------------------
# Any gateway that accepts an HTTP request works. {to}, {text} and {from} are
# substituted into the URL and body, escaped for the content type.
#
# SILEXGIS__Sms__Enabled=true
# SILEXGIS__Sms__Url=https://gateway.example.org/send
# SILEXGIS__Sms__Method=POST
# SILEXGIS__Sms__ContentType=application/x-www-form-urlencoded
# SILEXGIS__Sms__BodyTemplate=To={to}&From={from}&Body={text}
# Whole Authorization header value, e.g. "Basic <base64 of user:pass>" or "Bearer <token>":
# SILEXGIS__Sms__AuthHeader=Basic eW91cjpjcmVkcw==
# SILEXGIS__Sms__From=+40712345678
#
# Twilio, as a worked example:
# SILEXGIS__Sms__Url=https://api.twilio.com/2010-04-01/Accounts/<ACCOUNT_SID>/Messages.json
# SILEXGIS__Sms__AuthHeader=Basic <base64 of ACCOUNT_SID:AUTH_TOKEN>
# SILEXGIS__Sms__BodyTemplate=To={to}&From={from}&Body={text}
#
# A JSON gateway instead:
# SILEXGIS__Sms__ContentType=application/json
# SILEXGIS__Sms__BodyTemplate={"to":"{to}","from":"{from}","message":"{text}"}

# ---------------------------------------------------------------------------
# Sign-in policy (optional; also editable in the admin UI)
# ---------------------------------------------------------------------------
# Refuse sign-in until the address is confirmed. Has no effect while no mail
# server is configured — otherwise nobody could ever confirm.
# SILEXGIS__Security__RequireConfirmedEmail=false
# SILEXGIS__Security__SendConfirmationOnRegistration=true
# Which second factors accounts may use:
# SILEXGIS__Security__AuthenticatorTwoFactorEnabled=true
# SILEXGIS__Security__EmailTwoFactorEnabled=true
# Texted codes are off by default: a number can be moved to another SIM by
# persuading a mobile operator, which makes SMS the weakest of the three.
# SILEXGIS__Security__SmsTwoFactorEnabled=false
# SILEXGIS__Security__TwoFactorCodeLifetimeMinutes=5
# SILEXGIS__Security__TwoFactorResendIntervalSeconds=60

# ---------------------------------------------------------------------------
# Location protection (optional; also editable in the admin UI)
# ---------------------------------------------------------------------------
# Whether someone who may not see a protected cave's exact position is still
# told which documents are attached to it. The documents themselves are served
# either way — this only affects the pairing. Off by default: naming the cave a
# report is about is a much smaller disclosure than where the cave is, but it is
# still one. Switching it on never reveals a position, and a photo carrying its
# own capture point stays unpaired with a protected cave whatever this says.
# SILEXGIS__Protection__RevealProtectedAssociations=false

# Name used in the messages this installation sends ({appName} in the templates):
# SILEXGIS__About__InstanceName=SilexGIS

# ---------------------------------------------------------------------------
# Document conversion (optional; needs the converter overlay running)
# ---------------------------------------------------------------------------
# Word, Excel, PowerPoint and OpenDocument files have no pages until something
# lays them out, so they cannot be shown page by page in the browser the way a
# PDF can. Start the converter overlay and set these two, and each such upload
# gets a PDF copy stored beside it — the original is never touched — which the
# application then draws pages from. Leave them out and those files are stored,
# searched and downloaded exactly as before, with no page to look at.
#   docker compose -f docker-compose.yml -f docker-compose.convert.yml up -d
# SILEXGIS__Conversion__Enabled=true
# SILEXGIS__Conversion__Url=http://convert:3000
# How long one conversion may take. Long documents are slow; a request cut
# short would be recorded as a document that would not open.
# SILEXGIS__Conversion__TimeoutSeconds=120
