{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:trips": "vite build --config vite.trips.config.ts",
    "lint": "oxlint --report-unused-disable-directives",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "node ../scripts/e2e.mjs",
    "e2e:fast": "node ../scripts/e2e.mjs --mode fast",
    "format": "prettier --write src",
    "generate:api": "node scripts/generate-api.mjs",
    "preview": "vite preview",
    "lint:deps": "depcruise src"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@tanstack/react-query": "^5.105.0",
    "@terrestris/ol-util": "^21.3.2",
    "@terrestris/react-geo": "^33.1.4",
    "antd": "6.5.2",
    "cesium": "^1.146.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "geotiff": "^3.0.5",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "mgrs": "^1.0.0",
    "oidc-client-ts": "^3.5.0",
    "ol": "~10.9.0",
    "ol-mapbox-style": "^13.8.0",
    "ol-pmtiles": "2.0.2",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "^6.4.299",
    "pmtiles": "4.5.0",
    "proj4": "^2.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-resizable-panels": "^4.15.2",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.7.0",
    "jsdom": "^30.1.3",
    "less": "^4.9.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "~1.78.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.12"
  }
}
