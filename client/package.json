{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:trips": "vite build --config vite.trips.config.ts",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "node ../scripts/e2e.mjs",
    "e2e:fast": "node ../scripts/e2e.mjs --mode fast",
    "format": "prettier --write src",
    "generate:api": "node scripts/generate-api.mjs",
    "preview": "vite preview",
    "lint:deps": "depcruise src"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@tanstack/react-query": "^5.104.1",
    "@terrestris/ol-util": "^21.3.2",
    "@terrestris/react-geo": "^33.1.4",
    "antd": "^6.6.5",
    "cesium": "^1.146.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "oidc-client-ts": "^3.5.0",
    "ol": "^10.11.0",
    "ol-mapbox-style": "^13.5.1",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-resizable-panels": "^4.14.2",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.5.0",
    "jsdom": "^29.1.1",
    "less": "^4.9.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^8.3.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10"
  }
}
