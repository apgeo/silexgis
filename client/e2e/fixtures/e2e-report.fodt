 </office:automatic-styles>
 <office:body>
  <office:text>
   <text:p>Raport de explorare pentru Peștera Demo Mare.</text:p>
   <text:p>Prima pagina descrie intrarea si accesul.</text:p>
   <text:p text:style-name="BreakBefore">Pagina a doua: sifonul terminal hidrogeologiedemo.</text:p>
   <text:p>Galeria principala masoara 412 metri.</text:p>
  </office:text>
 </office:body>
