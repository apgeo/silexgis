{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }],
    "Enrich": ["FromLogContext"]
  },
  "About": {
    "SourceUrl": "https://github.com/apgeo/silexgis",
    "InstanceName": "SilexGIS"
  },
  "Mail": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "Security": "Auto",
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "SilexGIS",
    "ReplyTo": "",
    "TimeoutSeconds": 30,
    "AcceptInvalidCertificate": false
  },
  "Notifications": {
    "PollSeconds": 15,
    "DigestHourUtc": 7,
    "RetentionDays": 365,
    "BadgeTransport": "poll",
    "AnnouncementFanOutLimit": 50
  },
  "Announcements": {
    "PaidChannelsEnabled": false,
    "DailyPaidMessageCap": 100
  },
  "Sms": {
    "Enabled": false,
    "Url": "",
    "Method": "POST",
    "ContentType": "application/x-www-form-urlencoded",
    "BodyTemplate": "To={to}&From={from}&Body={text}",
    "AuthHeader": "",
    "From": "",
    "TimeoutSeconds": 15
  },
  "Security": {
    "RequireConfirmedEmail": false,
    "SendConfirmationOnRegistration": true,
    "AuthenticatorTwoFactorEnabled": true,
    "EmailTwoFactorEnabled": true,
    "SmsTwoFactorEnabled": false,
    "TwoFactorCodeLifetimeMinutes": 5,
    "TwoFactorResendIntervalSeconds": 60
  },
  "Protection": {
    "RevealProtectedAssociations": false
  },
  "Db": {
    "ConnectionString": "",
    "AutoMigrate": true
  },
  "FeatureIntegrity": {
    "Interval": "1.00:00:00"
  },
  "TripCallout": {
    "SweepInterval": "00:15:00",
    "ReminderLead": "2.00:00:00"
  },
  "PublicUrl": "http://localhost:8080",
  "Auth": {
    "OpenRegistration": false,
    "DefaultPermissionGroups": "",
    "AdditionalRedirectUris": [],
    "ExternalOnly": false,
    "ExternalProviders": []
  },
  "Admin": {
    "Email": "",
    "Password": ""
  },
  "AllowedHosts": "*"
}
