{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }],
    "Enrich": ["FromLogContext"]
  },
  "About": {
    "SourceUrl": "https://github.com/apgeo/silexgis"
  },
  "Db": {
    "ConnectionString": "",
    "AutoMigrate": true
  },
  "PublicUrl": "http://localhost:8080",
  "Auth": {
    "OpenRegistration": false,
    "DefaultRole": "Viewer",
    "AdditionalRedirectUris": [],
    "ExternalOnly": false,
    "ExternalProviders": []
  },
  "Admin": {
    "Email": "",
    "Password": ""
  },
  "AllowedHosts": "*"
}
