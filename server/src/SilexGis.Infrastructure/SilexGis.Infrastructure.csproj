<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SilexGis.Domain\SilexGis.Domain.csproj" />
    <!-- Readers for the two compiled cave-survey formats this application stores but could not
         previously open: Therion Loch (.lox) and Survex image (.3d). Original MPL-2.0 C# carrying
         no dependencies of its own, consumed from its own repository as a submodule rather than
         copied in, so that corrections flow back to the one place the code lives. MPL-2.0
         combines into this project's AGPL-3.0 because those sources are deliberately not marked
         "Incompatible With Secondary Licenses". Referenced from Infrastructure and not from
         Domain on purpose: parsing untrusted uploaded bytes is infrastructure work, and the
         architecture tests assert that placement rather than trusting it. -->
    <ProjectReference Include="..\..\external\ThIDE\src\Therion.Blender\Therion.Blender.csproj" />
    <!-- The reader for what a Therion compilation printed while it ran: the loop-error table it
         reports, the versions it ran at and whether it finished. Same repository, same submodule
         pin and the same MPL-2.0 terms as the module above, so the licence argument is unchanged.
         It is a different module, and it costs more than the first one did: it brings two further
         projects with it (Therion.Core and Therion.Processing.Abstractions), and it shares one flat
         namespace with code that starts an external process. Checked before taking it — none of the
         three declares a NuGet package reference, so nothing new enters the package audit; the
         process-starting types are named individually in the architecture test that asserts nothing
         here reaches them, because a namespace-wide exclusion would have banned the reader too. -->
    <ProjectReference Include="..\..\external\ThIDE\src\Therion.Build\Therion.Build.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <!-- Converts the pre-2007 binary Word and PowerPoint formats into the packaged ones so the
         reader for those can read them. MIT, and on this framework they pull one shared MIT
         package with no dependencies of its own. Do NOT add the renderer package alongside
         them: it is not needed here and it carries commercial terms. -->
    <PackageReference Include="DocSharp.Binary.Doc" Version="0.20.0" />
    <PackageReference Include="DocSharp.Binary.Ppt" Version="0.20.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
    <PackageReference Include="MaxRev.Gdal.Core" Version="3.13.1.534" />
    <PackageReference Include="MaxRev.Gdal.LinuxRuntime.Minimal" Version="3.13.1.534" />
    <PackageReference Include="MaxRev.Gdal.WindowsRuntime.Minimal" Version="3.13.1.534" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.2" />
    <!-- Pinned to the last Apache-2.0 release: 2.8.0 moved to a maintenance-fee licence whose
         terms this project cannot ship under. Do not upgrade past 2.7.x without re-reading it. -->
    <PackageReference Include="NPOI" Version="2.7.6" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.5.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <!-- Transitive only: the legacy Office reader asks for a version carrying known advisories,
         and the build treats the audit warning as an error. Raised here to a clean one. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
