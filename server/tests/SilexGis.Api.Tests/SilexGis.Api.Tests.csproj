<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The application runs Server GC; this project builds a host per test and did not, so every
         concurrent host construction collected on one heap. Measured 12.7% at 8-way parallelism. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <!-- Transitive only: the version this graph would otherwise settle on carries known
         advisories, and the build treats the audit warning as an error. Pinned here rather
         than in the product projects, which resolve a clean version on their own.
         SSH.NET arrives under the container library, which asks for 2025.1.0 — a version
         carrying a high-severity advisory. No code in this project calls it; removing the
         reference as "unused" breaks the restore, for a reason nothing near the removal
         explains. It goes when the container library's own floor moves past the advisory. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each test class owns its database, so the classes are free to run together. Without this
         file xunit still runs one collection at a time and the suite stays serial. Eight was
         measured against four, twelve and twenty; more threads stop paying while every test still
         builds its own host. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real files of their format, read by tests at run time. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Linked rather than copied: the browser tests drive the 3D viewer with this same export,
         and two copies of a binary fixture drift into two different caves. -->
    <None Include="..\..\..\client\e2e\fixtures\P8_Master.3d"
          Link="Fixtures\P8_Master.3d"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SilexGis.Api\SilexGis.Api.csproj" />
  </ItemGroup>

</Project>