# Normalize line endings: LF in the repository and on checkout. The project builds and runs on
# both Windows and Linux, so a file must not change content depending on which one checked it out.
* text=auto eol=lf

# Windows-only files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.tif binary
*.tiff binary
*.lox binary
*.3d binary
*.wav binary
